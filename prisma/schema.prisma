// =============================================================================
//  KÝ ỨC DI SẢN — Lược đồ Prisma
//
//  Bản Prisma của prisma/sql/schema.sql. Nguồn dữ liệu được suy ra từ các mảng
//  hard-code trong Unity project (3x3-ky-uc-di-san-game); mỗi model ghi rõ nó
//  đến từ script nào.
//
//  Ba schema Postgres:
//    content — danh mục tĩnh. Người chơi chơi thì dữ liệu ở đây không đổi.
//    game    — trạng thái người chơi. Chỉ server được ghi.
//    admin   — người quản trị và nhật ký thao tác.
//  Chiều phụ thuộc: game → content. Không bao giờ ngược lại.
//
//  ---------------------------------------------------------------------------
//  NHỮNG THỨ PRISMA KHÔNG DIỄN TẢ ĐƯỢC — bắt buộc viết tay trong migration SQL:
//    1. CHECK constraint (balance >= 0, XOR tiền thật/tiền game, uid ~ 12 số...).
//    2. Partial index (WHERE status = 'published', WHERE deleted_at IS NULL...).
//       Prisma chỉ tạo index đầy đủ; các @@index dưới đây là bản rút gọn.
//    3. Functional unique index: lower(display_name), lower(subject).
//    4. Trigger set_updated_at() và game.seed_wallet().
//    5. GENERATED ALWAYS AS IDENTITY — @default(autoincrement()) của Prisma sinh
//       ra BIGSERIAL. Migration ở repo này viết tay nên vẫn giữ IDENTITY.
//
//  Quy trình đổi schema (DB là Supabase, không chạy được `prisma migrate dev`):
//    npx prisma migrate dev --create-only --name <ten>  → sửa SQL sinh ra
//    npm run prisma:deploy                              → áp dụng
//    Nhớ `alter table ... enable row level security` cho MỌI bảng mới.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // multiSchema (nhiều schema trong một datasource) đã GA từ Prisma 6, không cần
  // khai previewFeatures nữa — chỉ cần `schemas` ở datasource bên dưới.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["admin", "content", "game", "public"]
}

// =============================================================================
//  0. PUBLIC — BẢNG CŨ CỦA BACKEND (đang trong giai đoạn chuyển đổi)
//
//  src/modules/auth vẫn gọi prisma.user / prisma.session, nên ba model này PHẢI
//  còn ở đây cho tới khi module auth chuyển sang game.account + game.session.
//  Kịch bản chuyển dữ liệu: prisma/sql/migrate_public_users.sql (cố ý KHÔNG drop
//  bảng cũ — rollback lúc đó chỉ là đổi lại code, không phải khôi phục dữ liệu).
// =============================================================================

/// Tài khoản của bản backend hiện tại. Thay thế bởi Account + AuthIdentity +
/// AuthCredential + Player. Đừng thêm cột mới vào đây nữa.
model User {
  id               String   @id @default(uuid())
  /// Mã 12 số hiện cho người chơi xem. Chuyển thẳng sang Player.uid.
  uid              String   @unique
  username         String   @unique
  passwordHash     String
  /// Không có email nên không reset qua mail được — đây là đường cứu duy nhất.
  recoveryCodeHash String
  displayName      String?
  avatarUrl        String?
  role             String   @default("player")
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions Session[]
  progress UserProgress[]

  @@map("users")
  @@schema("public")
}

/// Phiên đăng nhập cũ. Refresh token thô không bao giờ chạm DB, chỉ lưu SHA-256.
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceInfo       String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  /// Mỗi lần refresh là thu hồi dòng cũ và phát cặp token mới (rotation).
  revokedAt        DateTime?

  @@index([userId])
  @@map("sessions")
  @@schema("public")
}

/// Bảng tiến trình của bản prototype: (stageId, score). Lược đồ mới KHÔNG có
/// bảng tương ứng — nếu stageId thật ra là nhiệm vụ thì đổ sang PlayerQuest,
/// còn không thì để nguyên tới lúc drop.
model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId     String
  score       Int      @default(0)
  completedAt DateTime @default(now())

  @@unique([userId, stageId])
  @@map("user_progress")
  @@schema("public")
}

// =============================================================================
//  1. KIỂU DÙNG CHUNG
// =============================================================================

/// Đúng ba danh mục thật. BagCategoryBar.Category.TatCa = 0 là BỘ LỌC GIAO DIỆN,
/// không phải danh mục vật phẩm — tuyệt đối không lưu xuống đây. Map thẳng số
/// nguyên enum của C# sang bảng này sẽ lệch đúng một bậc trên cả 32 vật phẩm.
enum ItemCategory {
  trang_bi
  thuc_pham
  dung_cu

  @@map("item_category")
  @@schema("content")
}

/// hoa sen  = tiền nạp (icon hud_icon_hoa_sen, hiện trên thẻ ở màn Nạp)
/// lồng đèn = tiền mềm (icon hud_icon_long_den, phần thưởng thư / nhiệm vụ)
enum CurrencyCode {
  hoa_sen
  long_den

  @@map("currency_code")
  @@schema("content")
}

/// Suy từ nhãn phân loại của gacha: "Trang phục cực phẩm", "Gia sản cấp gia tiên".
enum ItemGrade {
  thuong
  quy
  cuc_pham
  gia_tien

  @@map("item_grade")
  @@schema("content")
}

enum EquipSlot {
  non
  ao
  tay
  chan
  phu_kien

  @@map("equip_slot")
  @@schema("content")
}

/// Năm tab của ShopTabBar.Tab, đúng thứ tự trái sang phải.
enum ShopTab {
  nap
  nap_dau_cuc_hoi
  goi_uu_dai
  doi_qua_nap
  goi_tai_nguyen

  @@map("shop_tab")
  @@schema("content")
}

/// Bảng nào ở "lớp tải lúc chạy" thì mang cột status kiểu này: admin sửa bản
/// nháp thoải mái, chỉ 'published' mới ra tới người chơi.
///
/// 'archived' là NÚT XOÁ DUY NHẤT của trang quản trị. DELETE thật sẽ bị khoá
/// ngoại của dữ liệu người chơi chặn lại.
enum PublishStatus {
  draft
  published
  archived

  @@map("publish_status")
  @@schema("content")
}

/// Dùng chung cho mục tiêu nhiệm vụ lẫn điều kiện thành tựu.
/// Nguồn: UIScreenBuilder.HudQuests + danh sách thành tựu ("Cho thú cưng ăn 3
/// lần", "Sở hữu tối thiểu 10 nội thất cấp gia tiên"...).
enum ObjectiveKind {
  /// nhặt / thu thập N vật phẩm
  thu_thap
  /// mang N vật phẩm tới một NPC
  giao_vat_pham
  noi_chuyen_npc
  cho_thu_cung_an
  thu_hoach
  ve_tranh_kieng
  tieu_tien
  /// đang giữ tối thiểu N (ví dụ "10 nội thất cấp gia tiên")
  so_huu_vat_pham

  @@map("objective_kind")
  @@schema("content")
}

// =============================================================================
//  2. CONTENT — VẬT PHẨM
// =============================================================================

/// Nguồn: UIBagScreenBuilder.BagItems (32 dòng).
///
/// KHÔNG lưu ở đây: IconCenter, IconSize và mọi số đo Figma khác. Đó là bố cục,
/// thuộc về prefab, không phải thuộc tính vật phẩm.
model Item {
  /// Khớp tên sprite bag_item_<item_key>.png. Ví dụ co_dau_nhon, ca_rot.
  itemKey      String                   @id @map("item_key")
  displayName  String                   @map("display_name")
  /// Dòng mô tả trong khung chi tiết. Rỗng thì client ẩn dòng và dời gạch ngang
  /// lên. Trong repo chỉ đúng co_dau_nhon có mô tả, 31 cái còn lại rỗng.
  description  String                   @default("")
  category     ItemCategory
  grade        ItemGrade                @default(thuong)
  stackMax     Int                      @default(999) @map("stack_max")
  isEquippable Boolean                  @default(false) @map("is_equippable")
  isConsumable Boolean                  @default(false) @map("is_consumable")
  /// NULL = không hết hạn. Nguồn của thư hệ thống "Nhắc nhở vật phẩm hết hạn".
  /// Kiểu interval của Postgres không có kiểu Prisma tương ứng — đọc/ghi cột này
  /// phải dùng $queryRaw.
  shelfLife    Unsupported("interval")? @map("shelf_life")
  /// Vật phẩm đã vào túi ai đó thì không xoá được nữa — chuyển archived. Client
  /// vẫn phải hiển thị được item archived đang nằm trong túi cũ.
  status       PublishStatus            @default(draft)
  /// Chép theo đúng thứ tự mảng trong builder, để lưới túi đồ hiện y như Figma.
  sortOrder    Int                      @default(0) @map("sort_order")
  updatedAt    DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  equipmentProfile EquipmentProfile?
  cropsAsSeed      Crop[]            @relation("hat_giong")
  cropsAsHarvest   Crop[]            @relation("nong_san")
  rewardLines      RewardLine[]
  gachaItems       GachaItem[]
  inventories      Inventory[]

  @@index([category, sortOrder], map: "item_by_category")
  @@map("item")
  @@schema("content")
}

/// Chỉ 8 vật phẩm "Trang bị" (đồ làm nông) có dòng ở đây. Lưu ý dễ nhầm: danh
/// mục "Dụng cụ" trong game là đồ VẼ tranh kiếng, còn đồ LÀM NÔNG nằm ở "Trang bị".
model EquipmentProfile {
  itemKey String    @id @map("item_key")
  item    Item      @relation(fields: [itemKey], references: [itemKey], onDelete: Cascade)
  slot    EquipSlot
  /// Ví dụ {"toc_do_thu_hoach": 1.15, "so_o_tuoi_them": 1}.
  stats   Json      @default("{}")

  equipped PlayerEquipment[]

  /// Thừa về mặt lý thuyết (itemKey đã là PK) nhưng PlayerEquipment cần nó làm
  /// đích cho khoá ngoại ghép, để DB tự ép "đúng đồ, đúng ô".
  @@unique([itemKey, slot])
  @@map("equipment_profile")
  @@schema("content")
}

/// Tám vật phẩm Thực phẩm hiện có đều là nông sản, nhưng repo CHƯA có vật phẩm
/// hạt giống tương ứng. Phải thêm 8 item hạt giống trước khi seed bảng này.
model Crop {
  cropKey        String @id @map("crop_key")
  seedItemKey    String @map("seed_item_key")
  seedItem       Item   @relation("hat_giong", fields: [seedItemKey], references: [itemKey])
  harvestItemKey String @map("harvest_item_key")
  harvestItem    Item   @relation("nong_san", fields: [harvestItemKey], references: [itemKey])
  /// Server tự cộng vào planted_at để ra ready_at. Không tin đồng hồ client.
  growSeconds    Int    @map("grow_seconds")
  waterStages    Int    @default(1) @map("water_stages") @db.SmallInt
  yieldMin       Int    @default(1) @map("yield_min") @db.SmallInt
  yieldMax       Int    @default(1) @map("yield_max") @db.SmallInt

  farmPlots FarmPlot[]

  @@map("crop")
  @@schema("content")
}

/// Mẫu tranh cho minigame trong TranhKiengRoom (scene TranhKiengMiniGame).
model TranhKiengPattern {
  patternKey  String @id @map("pattern_key")
  displayName String @map("display_name")
  difficulty  Int    @default(1) @db.SmallInt
  /// Đường nét mẫu để client tô theo. NULL = mẫu chỉ có ảnh nền.
  outline     Json?
  sortOrder   Int    @default(0) @map("sort_order")

  artworks Artwork[]

  @@map("tranh_kieng_pattern")
  @@schema("content")
}

// =============================================================================
//  3. CONTENT — GÓI PHẦN THƯỞNG
//
//  Thư, nhiệm vụ, thành tựu và gói nạp đều trả thưởng. Thay vì lặp cột
//  "thưởng gì / bao nhiêu" ở bốn chỗ, tất cả trỏ về đây.
// =============================================================================

model RewardBundle {
  bundleId  BigInt  @id @default(autoincrement()) @map("bundle_id")
  /// Khoá tự nhiên để file seed và các môi trường khác nhau tham chiếu ổn định.
  bundleKey String  @unique @map("bundle_key")
  note      String?

  lines         RewardLine[]
  shopProducts  ShopProduct[]
  quests        Quest[]
  achievements  Achievement[]
  mailTemplates MailTemplate[]
  mails         Mail[]

  @@map("reward_bundle")
  @@schema("content")
}

/// Một dòng thưởng: hoặc tiền, hoặc vật phẩm. Không bao giờ cả hai, không bao
/// giờ trống — ép bằng CHECK ((currency IS NOT NULL) <> (item_key IS NOT NULL)).
///
/// Hai dòng "500 hoa sen" trong cùng một gói là lỗi nhập liệu, không phải ý đồ:
/// hai partial unique index bên SQL chặn, gộp lại thành một dòng amount = 1000.
model RewardLine {
  bundleId BigInt        @map("bundle_id")
  bundle   RewardBundle  @relation(fields: [bundleId], references: [bundleId], onDelete: Cascade)
  ordinal  Int           @db.SmallInt
  currency CurrencyCode?
  itemKey  String?       @map("item_key")
  item     Item?         @relation(fields: [itemKey], references: [itemKey])
  amount   Int

  @@id([bundleId, ordinal])
  @@map("reward_line")
  @@schema("content")
}

// =============================================================================
//  4. CONTENT — GACHA
// =============================================================================

/// Nguồn: UIGachaScreenBuilder.GachaItems.
model GachaItem {
  gachaItemKey  String  @id @map("gacha_item_key")
  displayName   String  @map("display_name")
  /// Dòng phân loại nhỏ dưới tên ("Trang phục cực phẩm"). Rỗng ⇒ client ẩn dòng
  /// (như "Giếng ước nguyện").
  subtitle      String  @default("")
  description   String
  /// Câu trích dẫn đè lên ảnh. Rỗng ⇒ client ẩn cả chữ lẫn bóng đổ của nó.
  quote         String  @default("")
  /// Quyết định sprite dãy sao gacha_sao_<rarity>.png. Hiện chỉ dùng 4 và 5.
  rarity        Int     @db.SmallInt
  /// Vật phẩm được cộng vào túi khi quay trúng. NULL = phần thưởng trang trí,
  /// chưa gắn với item nào trong túi đồ.
  grantsItemKey String? @map("grants_item_key")
  grantsItem    Item?   @relation(fields: [grantsItemKey], references: [itemKey])

  bannerEntries BannerEntry[]
  pulls         GachaPull[]

  @@map("gacha_item")
  @@schema("content")
}

model Banner {
  bannerId     BigInt        @id @default(autoincrement()) @map("banner_id")
  bannerKey    String        @unique @map("banner_key")
  displayName  String        @map("display_name")
  status       PublishStatus @default(draft)
  costCurrency CurrencyCode  @default(hoa_sen) @map("cost_currency")
  costAmount   Int           @map("cost_amount")
  /// Bảo hiểm: quay đủ ngần này lần chưa ra 5 sao thì lần kế tiếp ra chắc chắn.
  pity5Star    Int           @default(90) @map("pity_5_star") @db.SmallInt
  pity4Star    Int           @default(10) @map("pity_4_star") @db.SmallInt
  opensAt      DateTime      @map("opens_at") @db.Timestamptz(6)
  closesAt     DateTime?     @map("closes_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries BannerEntry[]
  states  BannerState[]
  pulls   GachaPull[]

  @@map("banner")
  @@schema("content")
}

model BannerEntry {
  bannerId     BigInt    @map("banner_id")
  banner       Banner    @relation(fields: [bannerId], references: [bannerId], onDelete: Cascade)
  gachaItemKey String    @map("gacha_item_key")
  gachaItem    GachaItem @relation(fields: [gachaItemKey], references: [gachaItemKey])
  /// Trọng số thô. Tỉ lệ thật = weight / SUM(weight) trong cùng bậc sao.
  weight       Int
  isFeatured   Boolean   @default(false) @map("is_featured")

  @@id([bannerId, gachaItemKey])
  @@map("banner_entry")
  @@schema("content")
}

// =============================================================================
//  5. CONTENT — CỬA HÀNG
// =============================================================================

/// Nguồn: UIShopScreenBuilder.TopupPacks (8 gói: x15 7.000VND … x1.300 599.000
/// VND). Giá trong Figma là chuỗi định dạng không nhất quán ("7.000VND" dính
/// liền, "25.000 VND" có dấu cách) — ở đây lưu số nguyên, format là việc client.
///
/// Bán bằng tiền thật XOR tiền trong game, không lẫn lộn (CHECK bên SQL).
model ShopProduct {
  productId   BigInt  @id @default(autoincrement()) @map("product_id")
  productKey  String  @unique @map("product_key")
  tab         ShopTab
  displayName String  @default("") @map("display_name")

  /// Nhánh tiền thật. Cùng một gói bán được qua CẢ HAI đường — PayOS và IAP —
  /// nên storeSku là tuỳ chọn: NULL = gói này chỉ bán qua PayOS. Đường nào được
  /// dùng là chuyện của từng đơn (PurchaseOrder.provider), không phải của gói.
  ///
  /// SKU phải đăng ký sẵn ở Google Play Console / App Store Connect — admin
  /// KHÔNG tự tạo được điểm giá mới, phải đăng ký trọn dải giá ngay lần nộp đầu.
  storeSku     String? @map("store_sku")
  /// VND không có đơn vị lẻ nên lưu integer đồng.
  priceVnd     Int?    @map("price_vnd")
  /// Nội dung chuyển khoản hiện trên app ngân hàng khi quét QR PayOS. PayOS giới
  /// hạn khoảng 25 ký tự (CHECK bên SQL) — kiểm lại với tài liệu PayOS hiện hành
  /// trước khi lên production. NULL thì server tự sinh từ productKey.
  transferNote String? @map("transfer_note")

  /// Nhánh tiền trong game (hai tab cuối: Đổi quà nạp, Gói tài nguyên).
  priceCurrency CurrencyCode? @map("price_currency")
  priceAmount   Int?          @map("price_amount")

  bundleId        BigInt       @map("bundle_id")
  bundle          RewardBundle @relation(fields: [bundleId], references: [bundleId])
  /// Huy hiệu x2 ở tab "Nạp đầu cực hời". Đọc từ đây, không hard-code theo chỉ số.
  bonusMultiplier Decimal      @default(1.00) @map("bonus_multiplier") @db.Decimal(3, 2)
  /// Chép sang PurchaseOrder.isOnce lúc đặt đơn; partial unique index bên đó mới
  /// là thứ thật sự ép. Ở đây chỉ là cấu hình.
  oncePerAccount  Boolean      @default(false) @map("once_per_account")

  status     PublishStatus @default(draft)
  sortOrder  Int           @default(0) @map("sort_order")
  activeFrom DateTime      @default(now()) @map("active_from") @db.Timestamptz(6)
  activeTo   DateTime?     @map("active_to") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders PurchaseOrder[]

  /// Truy vấn nóng của màn Nạp. Bản SQL thật là partial index WHERE status =
  /// 'published' — index này chỉ là phần Prisma diễn tả được.
  @@index([tab, sortOrder], map: "shop_product_live")
  @@map("shop_product")
  @@schema("content")
}

// =============================================================================
//  6. CONTENT — NPC, NHIỆM VỤ, THÀNH TỰU, THƯ, SỔ TAY
// =============================================================================

/// "chú Tư" trong nhiệm vụ mở màn. Không có FK nào trỏ tới npcKey vì
/// QuestObjective.targetKey trỏ nhiều bảng khác nhau tuỳ kind.
model Npc {
  npcKey      String @id @map("npc_key")
  displayName String @map("display_name")
  sceneName   String @default("MainScene") @map("scene_name")

  @@map("npc")
  @@schema("content")
}

/// Nguồn: UIScreenBuilder.HudQuests ("Thu thập 3 buồng dừa nước và mang về cho
/// chú Tư.", "Trò chuyện cùng chú Tư và tìm hiểu về cù lao."...).
model Quest {
  questKey      String        @id @map("quest_key")
  title         String
  summary       String
  chapter       Int           @default(1) @db.SmallInt
  /// CHECK bên SQL chỉ chặn tự trỏ mình. Vòng A→B→A phải kiểm ở tầng nhập liệu —
  /// DB không tự phát hiện được chu trình.
  requiresQuest String?       @map("requires_quest")
  requires      Quest?        @relation("phu_thuoc_nhiem_vu", fields: [requiresQuest], references: [questKey])
  unlocks       Quest[]       @relation("phu_thuoc_nhiem_vu")
  bundleId      BigInt?       @map("bundle_id")
  bundle        RewardBundle? @relation(fields: [bundleId], references: [bundleId])
  status        PublishStatus @default(draft)
  sortOrder     Int           @default(0) @map("sort_order")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  objectives   QuestObjective[]
  playerQuests PlayerQuest[]

  @@map("quest")
  @@schema("content")
}

model QuestObjective {
  questKey    String        @map("quest_key")
  quest       Quest         @relation(fields: [questKey], references: [questKey], onDelete: Cascade)
  ordinal     Int           @db.SmallInt
  kind        ObjectiveKind
  /// item_key / npc_key / crop_key / pattern_key — tuỳ theo kind. Không đặt FK
  /// được vì trỏ nhiều bảng; validate ở tầng nhập liệu.
  targetKey   String?       @map("target_key")
  targetCount Int           @default(1) @map("target_count")

  playerProgress PlayerQuestObjective[]

  @@id([questKey, ordinal])
  @@map("quest_objective")
  @@schema("content")
}

/// Nguồn: danh sách thành tựu trong UIScreenBuilder (màn 37:241).
model Achievement {
  achievementKey String        @id @map("achievement_key")
  title          String
  description    String
  kind           ObjectiveKind
  targetKey      String?       @map("target_key")
  /// BigInt vì "Tích lũy tiêu 700.000Đ" đếm bằng đồng, tràn int rất nhanh.
  targetCount    BigInt        @map("target_count")
  bundleId       BigInt?       @map("bundle_id")
  bundle         RewardBundle? @relation(fields: [bundleId], references: [bundleId])
  status         PublishStatus @default(draft)
  sortOrder      Int           @default(0) @map("sort_order")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  playerAchievements PlayerAchievement[]

  @@map("achievement")
  @@schema("content")
}

/// Nguồn: MailScreenController. Mẫu thư, KHÔNG phải thư đã gửi — xem Mail.
model MailTemplate {
  templateKey String                   @id @map("template_key")
  /// Giữ nguyên cặp ngoặc vuông "[Thư cá nhân]" — client tự bỏ khi hiện tiêu đề
  /// bên phải.
  title       String
  sender      String                   @default("")
  /// Dùng token {player_name}. Việc escape < > cho TMP rich text là của client,
  /// không nhét &lt; &gt; vào dữ liệu.
  body        String                   @default("")
  bundleId    BigInt?                  @map("bundle_id")
  bundle      RewardBundle?            @relation(fields: [bundleId], references: [bundleId])
  /// Hạn sống của thư kể từ lúc gửi. interval — phải đọc/ghi bằng $queryRaw.
  ttl         Unsupported("interval")?
  status      PublishStatus            @default(draft)
  updatedAt   DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mails Mail[]

  @@map("mail_template")
  @@schema("content")
}

/// Sổ tay di sản sau nút hud_guidebook. Ví dụ category: tranh_kieng, long_den,
/// cu_lao.
model CodexEntry {
  entryKey  String        @id @map("entry_key")
  title     String
  body      String
  category  String
  status    PublishStatus @default(draft)
  sortOrder Int           @default(0) @map("sort_order")

  unlocks CodexUnlock[]

  @@map("codex_entry")
  @@schema("content")
}

// =============================================================================
//  7. CONTENT — TRẠNG THÁI XUẤT BẢN
// =============================================================================

/// Đúng một dòng (PK là boolean true). Bấm "Xuất bản" ở trang quản trị thì tăng
/// version. Client gửi kèm version đang giữ; bằng nhau thì server trả 304, khỏi
/// tải lại toàn bộ danh mục.
model ConfigState {
  id          Boolean    @id @default(true)
  version     BigInt     @default(1)
  publishedAt DateTime   @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy String?    @map("published_by") @db.Uuid
  publisher   AdminUser? @relation(fields: [publishedBy], references: [adminId])

  @@map("config_state")
  @@schema("content")
}

// =============================================================================
//  8. ADMIN
// =============================================================================

model AdminUser {
  adminId   String   @id @default(dbgenerated("gen_random_uuid()")) @map("admin_id") @db.Uuid
  email     String   @unique
  /// bcrypt. Không bao giờ ra khỏi tầng repository — mọi DTO admin phải loại cột này.
  /// Unique index lower(email) nằm bên SQL, Prisma không diễn tả được.
  passwordHash String @map("password_hash")
  displayName  String @default("") @map("display_name")
  /// viewer chỉ xem; editor sửa được bản nháp; chỉ publisher mới bấm được Xuất bản.
  role      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  auditLogs AuditLog[]
  publishes ConfigState[]

  @@map("admin_user")
  @@schema("admin")
}

/// Bảng nào đụng tới tiền thì phải biết ai đổi, đổi từ gì sang gì, lúc nào.
model AuditLog {
  logId     BigInt               @id @default(autoincrement()) @map("log_id")
  adminId   String               @map("admin_id") @db.Uuid
  admin     AdminUser            @relation(fields: [adminId], references: [adminId])
  /// insert | update | delete | publish (ép bằng CHECK bên SQL).
  action    String
  tableName String               @map("table_name")
  rowKey    String               @map("row_key")
  before    Json?
  after     Json?
  ipAddress Unsupported("inet")? @map("ip_address")
  actedAt   DateTime             @default(now()) @map("acted_at") @db.Timestamptz(6)

  @@index([tableName, rowKey, actedAt(sort: Desc)], map: "audit_log_by_row")
  @@index([adminId, actedAt(sort: Desc)], map: "audit_log_by_admin")
  @@map("audit_log")
  @@schema("admin")
}

// =============================================================================
//  9. GAME — TÀI KHOẢN, ĐĂNG NHẬP, NHÂN VẬT
//
//  Thay thế public.users + public.sessions. Cấu trúc ba tầng:
//    Account (danh tính) → AuthIdentity (các cách đăng nhập) → Player (nhân vật)
//  Mật khẩu nằm ở AuthCredential, tách khỏi identity vì chỉ đúng một provider
//  có mật khẩu.
// =============================================================================

/// KHÔNG BAO GIỜ hard-delete: PurchaseOrder trỏ Player với onDelete: Restrict
/// nên DELETE sẽ lỗi khoá ngoại — và đó là chủ ý, hồ sơ tài chính phải giữ.
/// Xoá tài khoản = status 'deleted' + deletedAt, rồi job nền dọn PII sau hạn lưu.
model Account {
  accountId   String    @id @default(dbgenerated("gen_random_uuid()")) @map("account_id") @db.Uuid
  /// active | banned | deleted (CHECK bên SQL).
  status      String    @default("active")
  /// NULL khi status = 'banned' nghĩa là cấm vĩnh viễn. Ràng buộc chỉ chặn chiều
  /// ngược lại: tài khoản không bị cấm thì không được mang hạn cấm.
  bannedUntil DateTime? @map("banned_until") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  identities AuthIdentity[]
  sessions   GameSession[]
  player     Player?

  @@map("account")
  @@schema("game")
}

/// Một tài khoản gắn được nhiều cách đăng nhập: chơi thử bằng device rồi nâng
/// lên Google mà không mất tiến trình.
///
/// Hai unique index bên SQL không diễn tả được ở đây:
///   - (account_id, provider): mỗi account tối đa một identity mỗi provider.
///   - lower(subject) WHERE provider = 'username': tên đăng nhập không phân biệt
///     hoa thường — nguồn của mọi vụ "tôi gõ đúng mà không vào được".
model AuthIdentity {
  /// username | device | google | apple | email (CHECK bên SQL).
  provider  String
  /// Tên đăng nhập, device id, hoặc `sub` của Google/Apple.
  subject   String
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  linkedAt  DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  credential AuthCredential?

  @@id([provider, subject])
  @@index([accountId], map: "auth_identity_by_account")
  @@map("auth_identity")
  @@schema("game")
}

/// Chỉ provider 'username' mới có mật khẩu. Google/Apple/device không có gì để lưu.
///
/// Không có email nên không reset qua mail được: recoveryCodeHash là đường cứu
/// duy nhất. Mã gốc trả về đúng một lần lúc đăng ký / lúc reset.
model AuthCredential {
  provider         String
  subject          String
  identity         AuthIdentity @relation(fields: [provider, subject], references: [provider, subject], onDelete: Cascade)
  passwordHash     String       @map("password_hash")
  recoveryCodeHash String       @map("recovery_code_hash")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([provider, subject])
  @@map("auth_credential")
  @@schema("game")
}

/// Bản thay thế của public.sessions. Đặt tên GameSession vì tên model phải duy
/// nhất trong toàn file, còn Session đã thuộc về bảng cũ ở schema public.
model GameSession {
  sessionId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  account          Account   @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  /// SHA-256 của refresh token. Token thô không bao giờ chạm tới DB.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Bản SQL là partial index WHERE revoked_at IS NULL — truy vấn duy nhất chạy
  /// mỗi lần refresh token: phiên nào của account này còn sống.
  @@index([accountId], map: "session_active")
  @@map("session")
  @@schema("game")
}

/// Nhân vật trong game. Một account đúng một player (UNIQUE trên accountId).
/// Unique index lower(display_name) nằm bên SQL.
model Player {
  playerId     String   @id @default(dbgenerated("gen_random_uuid()")) @map("player_id") @db.Uuid
  accountId    String   @unique @map("account_id") @db.Uuid
  account      Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  /// Mã 12 số hiện cho người chơi xem và đọc cho CSKH. Khác playerId (uuid nội
  /// bộ) vì uuid không đọc qua điện thoại được.
  uid          String   @unique
  /// Thay cho token {player_name} trong thân thư.
  displayName  String   @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  level        Int      @default(1) @db.SmallInt
  exp          Int      @default(0)
  /// Mẫu số của "8 / 50" trên thanh tiêu đề Hòm thư. Hiện đang hard-code trong
  /// MailScreenController (mailCount = 8, mailCapacity = 50).
  mailCapacity Int      @default(50) @map("mail_capacity") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  save         PlayerSave?
  wallets      Wallet[]
  ledger       CurrencyLedger[]
  inventory    Inventory[]
  equipment    PlayerEquipment[]
  mails        Mail[]
  bannerStates BannerState[]
  gachaPulls   GachaPull[]
  orders       PurchaseOrder[]
  quests       PlayerQuest[]
  achievements PlayerAchievement[]
  farmPlots    FarmPlot[]
  artworks     Artwork[]
  codexUnlocks CodexUnlock[]

  @@map("player")
  @@schema("game")
}

/// SceneFlow đang giữ tư thế quay về trong biến static (pendingReturnPosition,
/// returnSceneName) — mất sạch khi thoát game. Bảng này là chỗ lưu bền.
model PlayerSave {
  playerId  String   @id @map("player_id") @db.Uuid
  player    Player   @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  sceneName String   @default("MainScene") @map("scene_name")
  posX      Float    @default(0) @map("pos_x") @db.Real
  posY      Float    @default(0) @map("pos_y") @db.Real
  posZ      Float    @default(0) @map("pos_z") @db.Real
  /// Chỉ lưu yaw: ThirdPersonLook giữ pivot ở Quaternion.identity nên pitch
  /// không thuộc về nhân vật.
  yaw       Float    @default(0) @db.Real
  /// DayNightCycle.timeOfDay, 0–24.
  dayTime   Float    @default(0) @map("day_time") @db.Real
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("player_save")
  @@schema("game")
}

// =============================================================================
//  10. GAME — VÍ & SỔ CÁI
//
//  Wallet là số dư hiện tại, CurrencyLedger là sổ chỉ-ghi-thêm. Mọi thay đổi số
//  dư phải kèm một dòng sổ TRONG CÙNG TRANSACTION. Lệch nhau nghĩa là có bug, và
//  sổ cho biết bug ở đâu. Đối soát hằng đêm:
//      wallet.balance = SUM(currency_ledger.delta) theo (player_id, currency)
// =============================================================================

/// Trigger game.seed_wallet() tạo sẵn đủ dòng ví cho mọi loại tiền ngay khi có
/// nhân vật, nên chỗ cộng/trừ tiền không cần ON CONFLICT DO UPDATE.
model Wallet {
  playerId String       @map("player_id") @db.Uuid
  player   Player       @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  currency CurrencyCode
  balance  BigInt       @default(0)

  @@id([playerId, currency])
  @@map("wallet")
  @@schema("game")
}

enum LedgerReason {
  nap_tien
  mua_hang
  quay_gacha
  nhan_thu
  thuong_nhiem_vu
  thuong_thanh_tuu
  ban_vat_pham
  hoan_tien
  gm_dieu_chinh

  @@map("ledger_reason")
  @@schema("game")
}

model CurrencyLedger {
  entryId        BigInt       @id @default(autoincrement()) @map("entry_id")
  playerId       String       @map("player_id") @db.Uuid
  player         Player       @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  currency       CurrencyCode
  /// Khác 0. Âm là trừ, dương là cộng.
  delta          BigInt
  /// Số dư SAU khi ghi dòng này — để dựng lại lịch sử mà không phải cộng dồn.
  balanceAfter   BigInt       @map("balance_after")
  reason         LedgerReason
  /// purchase_order | mail | gacha_pull | player_quest | player_achievement
  refType        String?      @map("ref_type")
  refId          String?      @map("ref_id")
  /// Bấm "Nhận" hai lần vì mạng lag thì KHÔNG được cộng tiền hai lần. Partial
  /// unique index (player_id, idempotency_key) bên SQL biến lần gọi lại thứ hai
  /// thành lỗi trùng, để tầng trên trả lại kết quả cũ.
  idempotencyKey String?      @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([playerId, createdAt(sort: Desc)], map: "ledger_by_player")
  /// Job đối soát hằng đêm quét theo cặp này; không có index thì nó seq-scan cả bảng.
  @@index([playerId, currency], map: "ledger_reconcile")
  @@map("currency_ledger")
  @@schema("game")
}

// =============================================================================
//  11. GAME — TÚI ĐỒ & TRANG BỊ
// =============================================================================

/// Xoá hẳn dòng khi quantity về 0. BagScreenController chỉ bật đúng số ô có vật
/// phẩm (slotRoots[i].SetActive(i < items.Length)), nên truy vấn "vật phẩm của
/// tôi" không bao giờ phải lọc bỏ số lượng 0.
model Inventory {
  playerId   String    @map("player_id") @db.Uuid
  player     Player    @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  itemKey    String    @map("item_key")
  item       Item      @relation(fields: [itemKey], references: [itemKey])
  quantity   Int
  acquiredAt DateTime  @default(now()) @map("acquired_at") @db.Timestamptz(6)
  /// MỘT dòng cho mỗi (player, item) nên KHÔNG lưu hạn theo từng lô. Quy tắc:
  /// mỗi lần nhận thêm, server đặt lại acquiredAt = now() và expiresAt = now() +
  /// Item.shelfLife (NULL nếu shelfLife NULL). Nhận thêm là gia hạn cả chồng —
  /// rộng lượng với người chơi nhưng nhất quán. Cộng quantity mà quên hạn là bug
  /// im lặng.
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)

  @@id([playerId, itemKey])
  @@index([expiresAt], map: "inventory_expiring")
  @@map("inventory")
  @@schema("game")
}

/// DB không kiểm được "món đó có trong túi không" — đó là việc của transaction
/// mặc đồ, đọc Inventory trước khi ghi vào đây.
model PlayerEquipment {
  playerId String           @map("player_id") @db.Uuid
  player   Player           @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  slot     EquipSlot
  itemKey  String           @map("item_key")
  /// Khoá ngoại GHÉP (itemKey, slot) → EquipmentProfile: ép luôn hai điều kiện —
  /// item phải trang bị được VÀ phải đúng ô của nó. FK trỏ thẳng Item thì không
  /// cản được việc nhét ca_rot vào ô 'non'.
  profile  EquipmentProfile @relation(fields: [itemKey, slot], references: [itemKey, slot])

  @@id([playerId, slot])
  @@map("player_equipment")
  @@schema("game")
}

// =============================================================================
//  12. GAME — HÒM THƯ
// =============================================================================

/// Chép nội dung ra khỏi template ngay lúc gửi: sửa văn bản mẫu về sau không
/// được phép làm đổi thư người chơi đã nhận.
model Mail {
  mailId         BigInt        @id @default(autoincrement()) @map("mail_id")
  playerId       String        @map("player_id") @db.Uuid
  player         Player        @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  /// NULL = thư do GM soạn tay, không đi từ mẫu nào.
  templateKey    String?       @map("template_key")
  template       MailTemplate? @relation(fields: [templateKey], references: [templateKey])
  title          String
  sender         String        @default("")
  body           String        @default("")
  bundleId       BigInt?       @map("bundle_id")
  bundle         RewardBundle? @relation(fields: [bundleId], references: [bundleId])
  /// Bản chụp RewardLine lúc gửi:
  ///   [{"currency":"hoa_sen","amount":100},{"item_key":"ca_rot","amount":3}]
  /// ĐÂY mới là thứ trả cho người chơi. bundleId giữ lại chỉ để tra cứu nguồn
  /// gốc — admin sửa gói thưởng ngày mai không được đổi thư gửi hôm qua.
  rewardSnapshot Json?         @map("reward_snapshot")
  sentAt         DateTime      @default(now()) @map("sent_at") @db.Timestamptz(6)
  readAt         DateTime?     @map("read_at") @db.Timestamptz(6)
  claimedAt      DateTime?     @map("claimed_at") @db.Timestamptz(6)
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(6)
  /// Xoá mềm: nút "Xoá" ở hòm thư chỉ đặt cột này.
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  /// Bản SQL còn một partial index nữa (WHERE claimed_at IS NULL AND deleted_at
  /// IS NULL) phục vụ nút "Nhận hết".
  @@index([playerId, sentAt(sort: Desc)], map: "mail_inbox")
  @@map("mail")
  @@schema("game")
}

// =============================================================================
//  13. GAME — GACHA
// =============================================================================

/// Bộ đếm pity theo từng banner. Reset về 0 mỗi khi trúng đúng bậc sao đó.
model BannerState {
  playerId   String @map("player_id") @db.Uuid
  player     Player @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  bannerId   BigInt @map("banner_id")
  banner     Banner @relation(fields: [bannerId], references: [bannerId])
  pullsTotal Int    @default(0) @map("pulls_total")
  since5Star Int    @default(0) @map("since_5_star")
  since4Star Int    @default(0) @map("since_4_star")

  @@id([playerId, bannerId])
  @@map("banner_state")
  @@schema("game")
}

/// Chỉ ghi thêm, không sửa không xoá. rngSeed để dựng lại được đúng kết quả khi
/// người chơi khiếu nại — với gacha có tiền thật, đây không phải tính năng phụ.
model GachaPull {
  pullId         BigInt    @id @default(autoincrement()) @map("pull_id")
  playerId       String    @map("player_id") @db.Uuid
  player         Player    @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  bannerId       BigInt    @map("banner_id")
  banner         Banner    @relation(fields: [bannerId], references: [bannerId])
  gachaItemKey   String    @map("gacha_item_key")
  gachaItem      GachaItem @relation(fields: [gachaItemKey], references: [gachaItemKey])
  /// Chép lại rarity lúc quay: admin đổi bậc sao của vật phẩm về sau không được
  /// làm sai lệch lịch sử.
  rarity         Int       @db.SmallInt
  wasPity        Boolean   @default(false) @map("was_pity")
  rngSeed        BigInt    @map("rng_seed")
  /// Bắt buộc, khác ledger: quay 10 lần bị lặp request là mất tiền thật.
  idempotencyKey String    @map("idempotency_key")
  pulledAt       DateTime  @default(now()) @map("pulled_at") @db.Timestamptz(6)

  @@unique([playerId, idempotencyKey], map: "gacha_pull_idempotent")
  @@index([playerId, pulledAt(sort: Desc)], map: "gacha_pull_history")
  @@map("gacha_pull")
  @@schema("game")
}

// =============================================================================
//  14. GAME — ĐƠN NẠP (PayOS + IAP)
//
//  KHÔNG BAO GIỜ tin client về chuyện đã trả tiền. Client chỉ được báo "tôi vừa
//  mua xong", không bao giờ được báo "hãy cộng cho tôi 560 hoa sen".
//    - PayOS: chỉ webhook mới đổi được status sang 'paid', và chỉ sau khi kiểm
//      chữ ký HMAC-SHA256 bằng checksum key VÀ đối chiếu amount đúng bằng
//      purchase_order.price_vnd. returnUrl chỉ để hiện màn "cảm ơn" — nó KHÔNG
//      phải bằng chứng thanh toán, đừng làm endpoint nào tin nó.
//    - IAP: biên lai phải xác thực với Google/Apple trước khi đổi 'paid'.
//
//  Luồng giao hàng PayOS, đúng một transaction, đọc từ PaymentWebhook:
//    SELECT ... FROM purchase_order WHERE payos_order_code = $1 FOR UPDATE
//    → kiểm status còn 'pending' và price_vnd khớp amount
//    → cộng ví + ghi CurrencyLedger (idempotencyKey = orderId)
//    → status = 'delivered', paidAt, deliveredAt
//    → PaymentWebhook.processedAt = now()
// =============================================================================

/// `cancelled` / `expired` là của PayOS: người chơi bấm huỷ ở trang thanh toán,
/// hoặc để link quá hạn. Nhét cả hai vào `failed` thì mất khả năng trả lời "bao
/// nhiêu người bỏ giữa chừng" — số liệu quan trọng nhất của màn Nạp.
///
/// Enum này chưa lên production nên còn thêm giá trị thoải mái. Sau khi đã chạy
/// thật thì phải `ALTER TYPE ... ADD VALUE`, và giá trị mới KHÔNG dùng được
/// trong cùng transaction vừa thêm nó — phải tách ra hai lần chạy.
enum OrderStatus {
  pending
  paid
  delivered
  failed
  cancelled
  expired
  refunded

  @@map("order_status")
  @@schema("game")
}

/// Ba cổng thanh toán, một bảng đơn: PayOS (chuyển khoản / VietQR) và IAP của
/// Google Play / App Store.
model PurchaseOrder {
  orderId      String      @id @default(dbgenerated("gen_random_uuid()")) @map("order_id") @db.Uuid
  /// onDelete: Restrict — KHÔNG cascade: hồ sơ tài chính phải sống lâu hơn nhân
  /// vật. Đây chính là lý do Account chỉ được xoá mềm.
  playerId     String      @map("player_id") @db.Uuid
  player       Player      @relation(fields: [playerId], references: [playerId], onDelete: Restrict)
  productId    BigInt      @map("product_id")
  product      ShopProduct @relation(fields: [productId], references: [productId])
  /// payos | google_play | app_store (CHECK bên SQL). Chốt ngay lúc tạo đơn,
  /// không nullable: người chơi chọn cách trả tiền TRƯỚC khi có đơn. Cột này
  /// quyết định luồng xác thực nào chạy ở bước sau.
  provider     String
  status       OrderStatus @default(pending)
  /// CHÉP LẠI giá tại thời điểm đặt, không join ngược về ShopProduct. Admin đổi
  /// giá ngày mai không được phép làm sai lệch đơn hàng hôm qua. Với PayOS đây
  /// cũng là số phải KHỚP với `amount` trong webhook — lệch một đồng là không
  /// giao hàng, ghi log rồi báo động.
  priceVnd     Int         @map("price_vnd")
  /// Chép từ ShopProduct.oncePerAccount lúc đặt đơn. Partial unique index
  /// (player_id, product_id) WHERE is_once AND status IN ('paid','delivered')
  /// mới là chỗ THẬT SỰ ép giới hạn — không cần SELECT ... FOR UPDATE.
  isOnce       Boolean     @default(false) @map("is_once")
  bonusApplied Boolean     @default(false) @map("bonus_applied")

  /// Mã giao dịch phía cổng. PayOS: `paymentLinkId`. IAP: `purchaseToken` /
  /// `transactionId`. Tên chung vì unique index chống giao hàng hai lần dùng chung.
  providerTxnId   String? @map("provider_txn_id")
  /// Nguyên văn thứ cổng trả về: biên lai IAP, hoặc `data` của webhook PayOS cuối
  /// cùng. Giữ để đối soát, không phải để truy vấn.
  providerPayload Json?   @map("provider_payload")

  // --- Chỉ đơn PayOS mới có (CHECK bên SQL chặn lem sang đơn IAP) ---
  /// PayOS định danh đơn bằng orderCode: một SỐ NGUYÊN dương, không phải uuid.
  /// Lấy từ `nextval('game.payos_order_code_seq')`. Đây là khoá để tra ngược từ
  /// webhook về đơn, vì PayOS chỉ gửi orderCode chứ không biết orderId uuid.
  payosOrderCode BigInt?   @unique @map("payos_order_code")
  checkoutUrl    String?   @map("checkout_url")
  /// Chuỗi VietQR thô. Client tự vẽ QR, KHÔNG lưu ảnh xuống DB.
  qrCode         String?   @map("qr_code")
  linkExpiresAt  DateTime? @map("link_expires_at") @db.Timestamptz(6)
  /// Mã tham chiếu ngân hàng trong webhook. Thứ người chơi đọc cho CSKH khi bảo
  /// "tôi chuyển rồi mà chưa nhận".
  bankReference  String?   @map("bank_reference")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  webhooks PaymentWebhook[]

  /// Cùng một giao dịch phía cổng không bao giờ được giao hàng hai lần.
  @@unique([provider, providerTxnId], map: "purchase_provider_txn")
  @@index([playerId, createdAt(sort: Desc)], map: "purchase_by_player")
  /// Bản SQL là partial index WHERE status = 'pending' AND provider = 'payos',
  /// phục vụ job đóng đơn quá hạn về 'expired'. Không có job đó thì đơn treo
  /// 'pending' mãi mãi và oncePerAccount bị kẹt theo.
  @@index([linkExpiresAt], map: "purchase_payos_pending")
  @@map("purchase_order")
  @@schema("game")
}

/// Chỉ ghi thêm. Mọi thứ cổng thanh toán gửi tới đều rơi vào đây TRƯỚC rồi mới
/// xử lý: nhận webhook = INSERT + trả 200 NGAY, việc giao hàng để transaction
/// riêng đọc từ đây ra. Cổng thanh toán không cần biết mình giao hàng nhanh hay
/// chậm, và không được phép timeout vì mình xử lý lâu.
model PaymentWebhook {
  webhookId   BigInt         @id @default(autoincrement()) @map("webhook_id")
  /// payos | google_play | app_store (CHECK bên SQL).
  provider    String
  /// PayOS: `data.orderCode` ép sang text. IAP: `purchaseToken`.
  externalId  String         @map("external_id")
  /// NULL khi không tra ra đơn nào — webhook rác, hoặc đơn đã bị xoá. Vẫn phải
  /// lưu lại, đó là lúc cần vết nhất.
  orderId     String?        @map("order_id") @db.Uuid
  order       PurchaseOrder? @relation(fields: [orderId], references: [orderId])
  signature   String?
  /// Ghi lại KẾT QUẢ kiểm chữ ký HMAC-SHA256, không phải "đã kiểm chưa".
  /// false = có kẻ giả mạo hoặc checksum key sai; cả hai đều đáng báo động.
  signatureOk Boolean        @map("signature_ok")
  payload     Json
  receivedAt  DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?      @map("processed_at") @db.Timestamptz(6)
  error       String?

  /// PayOS gửi lại cùng một sự kiện thì chữ ký y hệt (HMAC trên cùng bộ data).
  /// Lần gửi lại thứ hai ăn lỗi trùng, tầng trên bắt lỗi đó rồi trả 200 luôn —
  /// cùng cơ chế idempotency đã dùng cho ledger và gacha. Bản SQL là partial
  /// unique index WHERE signature IS NOT NULL.
  @@unique([provider, signature], map: "payment_webhook_dedupe")
  /// Partial index WHERE processed_at IS NULL bên SQL: hàng đợi chưa xử lý.
  @@index([receivedAt], map: "payment_webhook_pending")
  @@index([orderId, receivedAt(sort: Desc)], map: "payment_webhook_by_order")
  @@map("payment_webhook")
  @@schema("game")
}

// =============================================================================
//  15. GAME — TIẾN TRÌNH
// =============================================================================

enum QuestStatus {
  dang_lam
  hoan_thanh
  da_nhan_thuong

  @@map("quest_status")
  @@schema("game")
}

model PlayerQuest {
  playerId    String      @map("player_id") @db.Uuid
  player      Player      @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  questKey    String      @map("quest_key")
  quest       Quest       @relation(fields: [questKey], references: [questKey])
  status      QuestStatus @default(dang_lam)
  startedAt   DateTime    @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz(6)
  claimedAt   DateTime?   @map("claimed_at") @db.Timestamptz(6)

  objectives PlayerQuestObjective[]

  @@id([playerId, questKey])
  @@map("player_quest")
  @@schema("game")
}

/// Tiến độ từng mục tiêu. Hai khoá ngoại ghép: một trỏ về PlayerQuest (để cascade
/// khi bỏ nhiệm vụ), một trỏ về QuestObjective (để không có tiến độ cho mục tiêu
/// không tồn tại).
model PlayerQuestObjective {
  playerId String @map("player_id") @db.Uuid
  questKey String @map("quest_key")
  ordinal  Int    @db.SmallInt
  progress Int    @default(0)

  playerQuest PlayerQuest    @relation(fields: [playerId, questKey], references: [playerId, questKey], onDelete: Cascade)
  objective   QuestObjective @relation(fields: [questKey, ordinal], references: [questKey, ordinal])

  @@id([playerId, questKey, ordinal])
  @@map("player_quest_objective")
  @@schema("game")
}

model PlayerAchievement {
  playerId       String      @map("player_id") @db.Uuid
  player         Player      @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  achievementKey String      @map("achievement_key")
  achievement    Achievement @relation(fields: [achievementKey], references: [achievementKey])
  /// BigInt để khớp Achievement.targetCount (đếm bằng đồng).
  progress       BigInt      @default(0)
  unlockedAt     DateTime?   @map("unlocked_at") @db.Timestamptz(6)
  claimedAt      DateTime?   @map("claimed_at") @db.Timestamptz(6)

  @@id([playerId, achievementKey])
  @@map("player_achievement")
  @@schema("game")
}

/// readyAt do server tính lúc gieo. Không tin đồng hồ client — đó là lỗ hổng
/// kinh điển của mọi game nông trại.
model FarmPlot {
  playerId   String    @map("player_id") @db.Uuid
  player     Player    @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  /// Chỉ số ô đất trong ruộng, khớp thứ tự ô ở scene.
  plotIndex  Int       @map("plot_index") @db.SmallInt
  /// NULL = ô đất trống. CHECK bên SQL ép cropKey / plantedAt / readyAt cùng
  /// NULL hoặc cùng có, và ô trống thì waterCount phải bằng 0.
  cropKey    String?   @map("crop_key")
  crop       Crop?     @relation(fields: [cropKey], references: [cropKey])
  plantedAt  DateTime? @map("planted_at") @db.Timestamptz(6)
  readyAt    DateTime? @map("ready_at") @db.Timestamptz(6)
  waterCount Int       @default(0) @map("water_count") @db.SmallInt

  @@id([playerId, plotIndex])
  @@index([readyAt], map: "farm_plot_ready")
  @@map("farm_plot")
  @@schema("game")
}

/// Kết quả minigame vẽ tranh kiếng trong TranhKiengRoom.
model Artwork {
  artworkId  BigInt            @id @default(autoincrement()) @map("artwork_id")
  playerId   String            @map("player_id") @db.Uuid
  player     Player            @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  patternKey String            @map("pattern_key")
  pattern    TranhKiengPattern @relation(fields: [patternKey], references: [patternKey])
  /// 0–100.
  score      Int               @db.SmallInt
  /// 0–3 sao, suy từ score theo ngưỡng của client.
  stars      Int               @db.SmallInt
  /// Nét vẽ đã lưu, để dựng lại bức tranh trong sổ tay. NULL nếu chỉ lưu điểm.
  strokes    Json?
  finishedAt DateTime          @default(now()) @map("finished_at") @db.Timestamptz(6)

  @@index([playerId, finishedAt(sort: Desc)], map: "artwork_by_player")
  @@map("artwork")
  @@schema("game")
}

/// Mục sổ tay đã mở khoá. Không có dòng = chưa mở.
model CodexUnlock {
  playerId   String     @map("player_id") @db.Uuid
  player     Player     @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  entryKey   String     @map("entry_key")
  entry      CodexEntry @relation(fields: [entryKey], references: [entryKey])
  unlockedAt DateTime   @default(now()) @map("unlocked_at") @db.Timestamptz(6)

  @@id([playerId, entryKey])
  @@map("codex_unlock")
  @@schema("game")
}
