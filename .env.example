PORT=3000

# --- Database ---
# Local Postgres:
#   DATABASE_URL="postgresql://user:password@localhost:5432/kuds?schema=public"
#   DIRECT_URL="postgresql://user:password@localhost:5432/kuds?schema=public"
#
# Supabase (Dashboard > Connect > Session pooler, port 5432 — IPv4, giữ prepared statements).
# User có dạng postgres.<project-ref>, thay [YOUR-PASSWORD] bằng Database Password đã đặt lúc tạo project.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Prisma CLI (migrate) dùng DIRECT_URL. Trên Supabase để giống DATABASE_URL,
# trừ khi mạng của bạn đi được IPv6 thì có thể trỏ vào direct connection db.<project-ref>.supabase.co:5432
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MAX_SESSIONS_PER_USER=5
SESSION_CLEANUP_INTERVAL_HOURS=24

# --- Đăng nhập Google ---
# Các OAuth client ID được chấp nhận trong `aud` của ID token, ngăn cách bằng dấu
# phẩy. Lấy ở Google Cloud Console > APIs & Services > Credentials.
#
# Unity build mỗi nền tảng ra một client ID riêng, và PHẢI liệt kê đủ ở đây:
#   - Android: tạo OAuth client "Android" (cần SHA-1 của keystore), nhưng ID token
#     client nhận được mang `aud` là client ID dạng "Web application" — điền CẢ HAI.
#   - iOS: OAuth client "iOS".
#   - Editor/PC: dùng client ID "Web application".
#
# Bỏ trống thì POST /auth/google trả 503 — cửa đóng hẳn, an toàn hơn là mở toang.
GOOGLE_CLIENT_IDS="123456789-abc.apps.googleusercontent.com,123456789-xyz.apps.googleusercontent.com"

# --- Quản trị ---
# Bí mật RIÊNG cho token trang quản trị. Tách khỏi JWT_SECRET có chủ ý: token
# người chơi và token admin không bao giờ được dùng lẫn nhau, kể cả khi một
# trong hai bị lộ. Không đặt thì server chạy được nhưng cảnh báo lúc khởi động.
# Sinh mới: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET="change-me-to-a-different-long-random-string"
# Admin không có refresh token — hết hạn là đăng nhập lại.
ADMIN_TOKEN_TTL=8h

# --- CORS ---
# Origin của kuds-frontend. Nhiều origin thì ngăn cách bằng dấu phẩy.
# "*" cho tất cả (chỉ nên dùng lúc dev).
CORS_ORIGINS="http://localhost:3001"
